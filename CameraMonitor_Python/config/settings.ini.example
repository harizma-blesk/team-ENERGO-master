# Конфигурационный файл для Camera Monitor
# Скопируйте settings.ini.example в settings.ini и отредактируйте

[Database]
# Путь к SQLite БД файлу
path=camera_monitor.db

[Camera]
# RTSP URL для подключения к камере
startRtcp=rtsp://user:password@192.168.1.100
# Постфикс потока
endRtcp=/ch01_sub.264
# Индекс локальной камеры (если RTSP не используется)
cameraIndex=0

[UDP]
# IP сервера Python backend
IP_PythonServer=127.0.0.1
# Порт для слушания входящих сообщений
IP_Port_Listen=5000
# Порт для отправки сообщений
IP_Port_Send=5001
# Удалённый порт (резервное)
IP_Port_Remote=5002

[NEUROMODEL]
# Путь к YOLO модели (скачивается автоматически)
WeightsPath=models/yolov8n.pt
# Порог уверенности для детекции
ConfThreshold=0.5
# Путь к файлу с названиями классов COCO
CocoNamesPath=data/coco.names

[TCP_Servers]
# IP адрес Java сервера
IP_Java=192.168.1.50
# Порт Java сервера
PORT_Java=2222
# IP адрес ESP устройства
IP_ESP=192.168.1.60
# Порт ESP устройства
PORT_ESP=44444

[Logging]
# Уровень логирования: DEBUG, INFO, WARNING, ERROR
level=INFO
# Формат логов
format=%(asctime)s - %(name)s - %(levelname)s - %(message)s
# Директория для логов
log_dir=logs

[GUI]
# Ширина главного окна
window_width=1200
# Высота главного окна
window_height=800
# Целевой FPS для обновления видео
fps_target=30
