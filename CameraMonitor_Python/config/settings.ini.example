[NEUROMODEL]
WeightsPath=models/yolov8n.onnx
ConfThreshold=0.5

[Logging]
level=INFO
format=%(asctime)s - %(name)s - %(levelname)s - %(message)s
log_dir=logs

[GUI]
window_width=1200
window_height=800
fps_target=30

[Laravel]
enabled=true
baseUrl=http://127.0.0.1:3333
syncIntervalSeconds=2
timeoutSeconds=3