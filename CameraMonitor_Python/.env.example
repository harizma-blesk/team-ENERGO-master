# Пример переменных окружения
# Копируйте в .env для локальной разработки

# Среда разработки: development или production
ENVIRONMENT=development

# Логирование
LOG_LEVEL=INFO

# Камера
CAMERA_RTSP_URL=rtsp://user:password@192.168.1.100/ch01_sub.264
CAMERA_INDEX=0

# YOLO Модель
YOLO_MODEL_PATH=models/yolov8n.pt
YOLO_CONF_THRESHOLD=0.5

# БД (SQLite)
DATABASE_PATH=camera_monitor.db

# Сетевые параметры
UDP_HOST=127.0.0.1
UDP_PORT_LISTEN=5000
UDP_PORT_SEND=5001

# TCP серверы
TCP_JAVA_HOST=192.168.1.50
TCP_JAVA_PORT=2222
TCP_ESP_HOST=192.168.1.60
TCP_ESP_PORT=44444

# GUI
WINDOW_WIDTH=1200
WINDOW_HEIGHT=800
FPS_TARGET=30
