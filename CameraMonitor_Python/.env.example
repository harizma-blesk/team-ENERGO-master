# Пример переменных окружения
# Копируйте в .env для локальной разработки

# Среда разработки: development или production
ENVIRONMENT=development

# Логирование
LOG_LEVEL=INFO

# Камера


# YOLO Модель
YOLO_MODEL_PATH=models/yolov8n.pt
YOLO_CONF_THRESHOLD=0.5



# GUI
WINDOW_WIDTH=1200
WINDOW_HEIGHT=800
FPS_TARGET=30
