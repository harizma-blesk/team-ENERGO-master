from PyQt5.QtCore import QObject, QThread, pyqtSlot, QTime, QDate
import logging

class AlgorithmManager(QObject):
    def __init__(self, file, parent=None):
        super().__init__(parent)

        self.database = DatabaseManager(file, self)
        self.database.openConnection()

        self.finder = AuditoryFinder(self.database, self)
        self.cleaner = TemporaryAuditoryCleaner(self.database, self)

        self.m_isChecking = False

        # Поток для checker
        self.checkerThread = QThread()

        self.cameraDatabase = DatabaseManager(file, None)
        self.checker = CameraChecker(file, self.cameraDatabase, None)

        self.cameraDatabase.moveToThread(self.checkerThread)
        self.checker.moveToThread(self.checkerThread)

        # Удаление после завершения потока
        self.checkerThread.finished.connect(self.checker.deleteLater)
        self.checkerThread.finished.connect(self.cameraDatabase.deleteLater)

        # Открытие БД при старте потока
        self.checkerThread.started.connect(
            self.cameraDatabase.openConnection
        )

        # Запуск мониторинга
        self.checkerThread.started.connect(
            self.checker.startMonitoring
        )

        self.checkerThread.start()

    @pyqtSlot(str, QTime, int)
    def slotGetFindRequest(self, targetCorpus, startTime, longness):
        if self.m_isChecking or not startTime.isValid():
            logging.warning("[ALGORITHMMANAGER] Rejecting request: Invalid time or busy.")
            return

        self.m_isChecking = True

        logging.debug(f"[ALGORITHMMANAGER] Новый запрос: Корпус {targetCorpus}, Время {startTime.toString()}")
        self.findNextAvailableRoom(targetCorpus, startTime, longness)

